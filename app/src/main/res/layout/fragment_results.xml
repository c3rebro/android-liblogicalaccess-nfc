<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin_horizontal"
        android:paddingTop="@dimen/content_margin_vertical"
        android:paddingBottom="@dimen/spacing_s"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/section_scan_history"
            android:textAppearance="@style/TextAppearance.App.SectionLabel" />

        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_history_empty"
            android:textSize="@dimen/text_size_body"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/content_margin_horizontal"
        android:paddingBottom="@dimen/spacing_s">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportAllScans"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/action_export_all_scans" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearHistory"
            style="@style/Widget.App.Button.Danger"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_s"
            android:text="@string/action_clear_history" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scanHistoryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/spacing_s"
        android:paddingBottom="@dimen/spacing_s"
        android:clipToPadding="false" />

</LinearLayout>
