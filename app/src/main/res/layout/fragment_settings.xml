<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="APPLICATION KEYS"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_blue_text"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/addQuickCheckKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add application key" />

        <Button
            android:id="@+id/clearQuickCheckKeys"
            android:backgroundTint="?attr/colorError"
            android:textColor="?attr/colorOnError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear application keys (including saved)" />

        <TextView
            android:id="@+id/quickCheckKeySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No application-specific quick-check keys configured."
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:typeface="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorControlNormal"
            android:alpha="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PICC MASTER KEY"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_blue_text"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="15sp"
            android:text="Required for Format and Factory Reset operations." />

        <Button
            android:id="@+id/setPiccKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set PICC master key" />

        <Button
            android:id="@+id/clearPiccKey"
            android:backgroundTint="?attr/colorError"
            android:textColor="?attr/colorOnError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Clear PICC master key" />

        <TextView
            android:id="@+id/piccKeySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No PICC master key configured."
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:typeface="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorControlNormal"
            android:alpha="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AUTORUN"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_blue_text"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Execute selected action automatically on card contact"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/autorunSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?attr/colorError"
            android:text="⚠  With autorun on, read and write actions start on card contact. Destructive actions still require confirmation."
            android:layout_marginBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorControlNormal"
            android:alpha="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SOUND"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_blue_text"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Play sound on action success / failure"
                android:textSize="14sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/soundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorControlNormal"
            android:alpha="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INFO"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_blue_text"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/versionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:typeface="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="?attr/colorControlNormal"
            android:alpha="0.2" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DEBUG"
            android:textStyle="bold"
            android:textSize="16sp"
            android:letterSpacing="0.1"
            android:textColor="@color/brand_blue_text"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/exportLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export log (zip)" />

    </LinearLayout>
</ScrollView>
