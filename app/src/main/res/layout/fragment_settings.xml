<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/content_margin_horizontal"
        android:paddingTop="@dimen/content_margin_vertical"
        android:paddingBottom="@dimen/spacing_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_application_keys"
            android:textAppearance="@style/TextAppearance.App.SectionLabel"
            android:layout_marginBottom="@dimen/section_margin_bottom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addQuickCheckKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_add_app_key" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearQuickCheckKeys"
            style="@style/Widget.App.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/action_clear_app_keys" />

        <TextView
            android:id="@+id/quickCheckKeySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/app_keys_none"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_size_body"
            android:typeface="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/section_margin_top"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_picc_master_key"
            android:textAppearance="@style/TextAppearance.App.SectionLabel"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/section_margin_bottom"
            android:textSize="@dimen/text_size_body"
            android:text="@string/picc_key_description" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/setPiccKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_set_picc_key" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearPiccKey"
            style="@style/Widget.App.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/action_clear_picc_key" />

        <TextView
            android:id="@+id/piccKeySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_m"
            android:text="@string/picc_key_none"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_size_body"
            android:typeface="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/section_margin_top"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_autorun"
            android:textAppearance="@style/TextAppearance.App.SectionLabel"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autorun_label"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autorunSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s" />

        </LinearLayout>

        <TextView
            android:id="@+id/autorunCurrentAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/text_size_body"
            android:textColor="?attr/colorError"
            android:text="@string/autorun_safety_warning"
            android:layout_marginBottom="@dimen/spacing_s" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/section_margin_top"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_sound"
            android:textAppearance="@style/TextAppearance.App.SectionLabel"
            android:layout_marginBottom="@dimen/spacing_xs" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/spacing_xs">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sound_label"
                android:textSize="@dimen/text_size_body" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/soundSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_s" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/section_margin_top"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_info"
            android:textAppearance="@style/TextAppearance.App.SectionLabel"
            android:layout_marginBottom="@dimen/section_margin_bottom" />

        <TextView
            android:id="@+id/versionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="@dimen/text_size_body"
            android:typeface="monospace" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/section_margin_top"
            android:layout_marginBottom="@dimen/spacing_l"
            android:background="?attr/colorOutlineVariant" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/section_debug"
            android:textAppearance="@style/TextAppearance.App.SectionLabel"
            android:layout_marginBottom="@dimen/section_margin_bottom" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportLog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_export_log" />

    </LinearLayout>
</ScrollView>
