<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.App.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/card_margin_vertical"
    android:layout_marginBottom="@dimen/card_margin_vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header row: always visible, clickable to expand/collapse -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/card_padding"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/headerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/headerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:alpha="0.7" />

            </LinearLayout>

            <!-- Status chip (Quick Check items only) -->
            <TextView
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textSize="10sp"
                android:letterSpacing="0.04"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginEnd="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/chevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9654;"
                android:textSize="18sp"
                android:layout_marginStart="@dimen/spacing_s" />

        </LinearLayout>

        <!-- Expandable body -->
        <LinearLayout
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:paddingBottom="@dimen/card_padding">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="@dimen/spacing_s"
                android:background="?attr/colorOutlineVariant" />

            <!-- Structured summary (Quick Check items with document) -->
            <LinearLayout
                android:id="@+id/structuredSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- STATUS row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="STATUS"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- UID row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="UID"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowUid"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true" />
                </LinearLayout>

                <!-- TECHNOLOGY row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="TECHNOLOGY"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowTech"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- FREE MEM row (optional) -->
                <LinearLayout
                    android:id="@+id/rowMemoryGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="FREE MEM"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowMemory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- APPLICATIONS row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="APPLICATIONS"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowApps"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- AUTH REQUIRED row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="AUTH REQ."
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowAuth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- PICC KEY row (optional) -->
                <LinearLayout
                    android:id="@+id/rowPiccKeyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="PICC KEY"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowPiccKey"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body" />
                </LinearLayout>

                <!-- WARNINGS row (optional) -->
                <LinearLayout
                    android:id="@+id/rowWarningsGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="2dp"
                    android:visibility="gone">
                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="WARNINGS"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel"
                        android:textSize="10sp" />
                    <TextView
                        android:id="@+id/rowWarnings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="@dimen/text_size_body"
                        android:textColor="?attr/colorError" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/spacing_s" />

            </LinearLayout>

            <!-- KEY_REQUIRED actionable suggestions (Quick Check PARTIAL items) -->
            <LinearLayout
                android:id="@+id/suggestionsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/spacing_s"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="@dimen/spacing_s"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    android:id="@+id/suggestionsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body"
                    android:layout_marginBottom="@dimen/spacing_xs" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddKey"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:text="@string/btn_add_key" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRescanOnce"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:text="@string/btn_rescan_once" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDismissSuggestions"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_dismiss" />

                </LinearLayout>

            </LinearLayout>

            <!-- Raw report toggle (Quick Check items only; non-QC items show raw directly) -->
            <LinearLayout
                android:id="@+id/rawToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingBottom="@dimen/spacing_xs"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:id="@+id/rawToggleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#9654;  Raw technical report"
                    android:textAppearance="@style/TextAppearance.App.SectionLabel"
                    android:alpha="0.7" />

            </LinearLayout>

            <!-- Raw section (monospace dump + environment) -->
            <LinearLayout
                android:id="@+id/rawSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:typeface="monospace"
                    android:textSize="@dimen/text_size_body" />

                <LinearLayout
                    android:id="@+id/environmentSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/spacing_l">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="READER / ENVIRONMENT"
                        android:textAppearance="@style/TextAppearance.App.SectionLabel" />

                    <TextView
                        android:id="@+id/environmentDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_size_body"
                        android:typeface="monospace"
                        android:textIsSelectable="true" />

                </LinearLayout>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportPdf"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_s"
                android:text="@string/btn_export_pdf"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
